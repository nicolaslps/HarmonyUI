{
    "name": "harmonyui/monorepo",
    "description": "Monorepo HarmonyUI : application(s) sous apps/ et package(s) partagé(s) sous packages/.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "rector/rector": "^2.5",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "vincentlanglet/twig-cs-fixer": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "rector": "rector process",
        "rector:dry": "rector process --dry-run",
        "phpstan": "phpstan analyse",
        "phpstan:baseline": "phpstan analyse --generate-baseline",
        "twig-cs": "twig-cs-fixer lint",
        "twig-cs:fix": "twig-cs-fixer lint --fix",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
