<div class="flex flex-col items-center gap-4">
    <twig:ui:Switch id="programmatic-switch" />
    <div class="flex gap-2">
        <twig:ui:Button size="sm" variant="outline" command="--check" commandfor="programmatic-switch">Turn on</twig:ui:Button>
        <twig:ui:Button size="sm" variant="outline" command="--uncheck" commandfor="programmatic-switch">Turn off</twig:ui:Button>
        <twig:ui:Button size="sm" variant="outline" command="--toggle" commandfor="programmatic-switch">Toggle</twig:ui:Button>
    </div>
</div>
