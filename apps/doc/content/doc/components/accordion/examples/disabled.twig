<twig:HarmonyUICore:Accordion>
    <twig:HarmonyUICore:Accordion:Item value="available">
        <twig:HarmonyUICore:Accordion:Header>Available item</twig:HarmonyUICore:Accordion:Header>
        <twig:HarmonyUICore:Accordion:Panel>
            This item can be toggled.
        </twig:HarmonyUICore:Accordion:Panel>
    </twig:HarmonyUICore:Accordion:Item>
    <twig:HarmonyUICore:Accordion:Item value="locked" disabled>
        <twig:HarmonyUICore:Accordion:Header>Disabled item</twig:HarmonyUICore:Accordion:Header>
        <twig:HarmonyUICore:Accordion:Panel>
            You should not be able to open this one.
        </twig:HarmonyUICore:Accordion:Panel>
    </twig:HarmonyUICore:Accordion:Item>
</twig:HarmonyUICore:Accordion>
