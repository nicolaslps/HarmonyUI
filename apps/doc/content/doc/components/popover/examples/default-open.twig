<twig:ui:Popover :open="true">
    <twig:ui:Popover:Trigger>
        <twig:ui:Button variant="outline" {{ ...popover_trigger_attrs }}>Open popover</twig:ui:Button>
    </twig:ui:Popover:Trigger>
    <twig:ui:Popover:Content class="w-56">
        Open on initial render.
    </twig:ui:Popover:Content>
</twig:ui:Popover>
