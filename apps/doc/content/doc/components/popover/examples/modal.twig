<twig:ui:Popover :modal="true">
    <twig:ui:Popover:Trigger>
        <twig:ui:Button variant="outline" {{ ...popover_trigger_attrs }}>Open modal popover</twig:ui:Button>
    </twig:ui:Popover:Trigger>
    <twig:ui:Popover:Content class="w-72">
        <div class="grid gap-1">
            <p class="text-sm leading-none font-medium text-neutral-950 dark:text-neutral-50">Rename file</p>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Tab stays trapped inside until you close this.</p>
        </div>
        <input
            value="Project Proposal.pdf"
            class="h-8 rounded-md border border-neutral-200 bg-transparent px-2 dark:border-neutral-700"
        />
        <div class="flex justify-end gap-2">
            <twig:ui:Button size="sm" data-scope="popover" data-part="close-trigger" data-owner="{{ inject('popover_id') }}">Save</twig:ui:Button>
        </div>
    </twig:ui:Popover:Content>
</twig:ui:Popover>
