            <twig:ui:Table:Cell class="text-end">$150.00</twig:ui:Table:Cell>
        </twig:ui:Table:Row>
        <twig:ui:Table:Row>
            <twig:ui:Table:Cell class="font-medium">INV003</twig:ui:Table:Cell>
