            <twig:ui:Table:Cell class="text-end">$350.00</twig:ui:Table:Cell>
        </twig:ui:Table:Row>
        <twig:ui:Table:Row>
            <twig:ui:Table:Cell class="font-medium">INV004</twig:ui:Table:Cell>
            <twig:ui:Table:Cell>
                <twig:ui:Badge color="green" variant="soft">Paid</twig:ui:Badge>
