            <twig:ui:Table:Cell class="text-end">$450.00</twig:ui:Table:Cell>
        </twig:ui:Table:Row>
    </twig:ui:Table:Body>
    <twig:ui:Table:Footer>
        <twig:ui:Table:Row>
            <twig:ui:Table:Cell colspan="3">Total</twig:ui:Table:Cell>
