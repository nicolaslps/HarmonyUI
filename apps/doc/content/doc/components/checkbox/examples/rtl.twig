<div class="flex flex-col gap-6">
    <div dir="rtl" class="flex flex-col gap-4">
        <twig:ui:Field orientation="horizontal">
            <twig:ui:Checkbox id="terms-ar" />
            <twig:ui:Label for="terms-ar">قبول الشروط والأحكام</twig:ui:Label>
        </twig:ui:Field>
        <twig:ui:Field orientation="horizontal" data-disabled>
            <twig:ui:Checkbox id="toggle-ar" disabled />
            <twig:ui:Field:Label for="toggle-ar">تفعيل الإشعارات</twig:ui:Field:Label>
        </twig:ui:Field>
    </div>
    <div dir="rtl" class="flex flex-col gap-4">
        <twig:ui:Field orientation="horizontal">
            <twig:ui:Checkbox id="terms-he" />
            <twig:ui:Label for="terms-he">קבל תנאים והגבלות</twig:ui:Label>
        </twig:ui:Field>
        <twig:ui:Field orientation="horizontal" data-disabled>
            <twig:ui:Checkbox id="toggle-he" disabled />
            <twig:ui:Field:Label for="toggle-he">הדלק התראות</twig:ui:Field:Label>
        </twig:ui:Field>
    </div>
</div>
