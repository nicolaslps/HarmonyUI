{% set bases = [
    {name: 'slate', swatch: 'bg-slate-500', border: 'data-active:border-slate-500 dark:data-active:border-slate-400'},
    {name: 'gray', swatch: 'bg-gray-500', border: 'data-active:border-gray-500 dark:data-active:border-gray-400'},
    {name: 'zinc', swatch: 'bg-zinc-500', border: 'data-active:border-zinc-500 dark:data-active:border-zinc-400'},
    {name: 'neutral', swatch: 'bg-neutral-500', border: 'data-active:border-neutral-500 dark:data-active:border-neutral-400'},
    {name: 'stone', swatch: 'bg-stone-500', border: 'data-active:border-stone-500 dark:data-active:border-stone-400'},
    {name: 'mauve', swatch: 'bg-mauve-500', border: 'data-active:border-mauve-500 dark:data-active:border-mauve-400'},
    {name: 'mist', swatch: 'bg-mist-500', border: 'data-active:border-mist-500 dark:data-active:border-mist-400'},
    {name: 'olive', swatch: 'bg-olive-500', border: 'data-active:border-olive-500 dark:data-active:border-olive-400'},
    {name: 'taupe', swatch: 'bg-taupe-500', border: 'data-active:border-taupe-500 dark:data-active:border-taupe-400'},
] %}

{% set radii = [
    {name: 'None', value: '0rem'},
    {name: 'Small', value: '0.45rem'},
    {name: 'Medium', value: '0.625rem'},
    {name: 'Large', value: '0.875rem'},
] %}

{% block body %}
    <div
        class="mx-auto flex max-w-4xl flex-col items-center gap-10 px-6 py-16"
        data-controller="theme-picker"
        data-theme-picker-primaries-value="{{ primaries|json_encode|e('html_attr') }}"
    >
        {{ include('themes/_header.html.twig') }}
        {{ include('themes/_mobile_picker.html.twig') }}
        {{ include('themes/_desktop_picker.html.twig') }}
        {{ include('themes/_actions.html.twig') }}
        {{ include('themes/_preview.html.twig') }}
    </div>
{% endblock %}
