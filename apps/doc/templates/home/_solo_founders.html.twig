<section class="grid items-center gap-8 py-16 lg:grid-cols-[1fr_2fr] lg:gap-14 lg:py-24">
    <div class="max-w-md">
        <p class="text-sm font-semibold tracking-widest text-neutral-600 dark:text-neutral-400 uppercase">
            Solo founders &amp; indie makers
        </p>
