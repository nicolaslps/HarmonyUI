&lt;/twig:ui:Button&gt;

&lt;twig:ui:Button variant="outline"&gt;
    Cancel
&lt;/twig:ui:Button&gt;</code></pre>
                    <div class="flex min-h-44 flex-col items-center justify-center gap-3 bg-white p-5">
