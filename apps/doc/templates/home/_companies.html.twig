                <div class="grid sm:grid-cols-[3fr_2fr]">
                    <pre class="overflow-x-auto border-b border-slate-200 bg-slate-50 p-5 font-mono text-xs leading-6 text-slate-700 sm:border-r sm:border-b-0"><code>return [
    'button' => new ComponentStyle(
        variants: [
            'variant' => [
                'extended' => 'bg-gradient-to-r
                    from-fuchsia-500 to-cyan-500
                    text-white',
            ],
        ],
    ),
];</code></pre>
                    <div class="flex min-h-44 flex-col items-center justify-center gap-3 bg-white p-5">
                        <twig:ui:Button variant="extended">Book a demo</twig:ui:Button>
