{% extends 'base.html.twig' %}

{% block title %}HarmonyUI — Symfony twig components that work, period.{% endblock %}

{% block body %}
    <section class="relative overflow-hidden">
        <div class="relative z-30 max-w-7xl mx-auto px-2 py-24 sm:py-32 lg:py-40">
            <div class="text-center">
                <h1 class="text-5xl font-black tracking-tight text-foreground text-balance sm:text-6xl lg:text-7xl xl:text-8xl">
                    <span class="text-primary">Symfony</span> twig components<br>that work<span class="hidden lg:inline-block">, period.</span>
                </h1>
                <div class="mt-2 lg:mt-8">
                    <span class="text-lg sm:text-xl lg:text-2xl font-light text-muted-foreground italic">
                        The foundation for your design system
                    </span>
                </div>

                <p class="mt-2 lg:mt-8 text-base leading-7 text-muted-foreground max-w-2xl mx-auto text-balance">
                    Beautiful, headless Twig components that you configure instead of fork. Keep your styling, get automatic updates, maintain zero technical debt.
                </p>

                <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6">
                    <twig:ui:Button as="a" size="lg" href="{{ path('app_docs', {slug: 'overview/getting-started'}) }}">
                        Get Started
                        <twig:ux:icon name="lucide:arrow-right" data-icon="inline-end" />
                    </twig:ui:Button>
                    <twig:ui:Button as="a" variant="outline" size="lg" href="{{ path('app_docs', {slug: 'components'}) }}">
                        Browse Components
                        <twig:ux:icon name="lucide:eye" data-icon="inline-end" />
                    </twig:ui:Button>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
