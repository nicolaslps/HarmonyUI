<!DOCTYPE html>
<html lang="en" class="scroll-pt-20">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {%- set seo_title -%}
            {%- block seo_title -%}
                HarmonyUI - Modern UI Component Library for Symfony
            {%- endblock -%}
        {%- endset -%}
        {%- set seo_title = seo_title|trim -%}
        {%- set seo_description -%}
            {%- block seo_description -%}
                Build stunning Symfony applications with HarmonyUI. Modern component library featuring beautiful Twig components, Tailwind CSS styling and Stimulus controllers. Free, open source and developer friendly.
            {%- endblock -%}
        {%- endset -%}
        {%- set seo_description = seo_description|trim -%}
        {% set seo_canonical = app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo %}
        {# Rendered on request by /og.png (cache pre-warmed at build time by app:og:warm) #}
        {%- set og_title -%}
            {%- block og_title -%}
                Modern UI component library for Symfony
            {%- endblock -%}
        {%- endset -%}
        {%- set og_description -%}
            {%- block og_description -%}
                {{ seo_description }}
            {%- endblock -%}
        {%- endset -%}
        {%- set seo_og_image = absolute_url(path('app_og_image', {title: og_title|trim, description: og_description|trim})) -%}

        <title>{{ seo_title }}</title>
        <meta name="description" content="{{ seo_description }}">
        {% if app.environment == 'prod' and not app.debug %}
            <meta name="robots" content="index, follow, max-image-preview:large">
        {% else %}
            <meta name="robots" content="noindex, nofollow">
        {% endif %}
        <link rel="canonical" href="{{ seo_canonical }}">
        <link rel="icon" type="image/svg+xml" href="{{ path('app_favicon') }}">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="HarmonyUI">
        <meta property="og:url" content="{{ seo_canonical }}">
        <meta property="og:title" content="{{ seo_title }}">
        <meta property="og:description" content="{{ seo_description }}">
        <meta property="og:image" content="{{ seo_og_image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ seo_title }}">
        <meta name="twitter:description" content="{{ seo_description }}">
        <meta name="twitter:image" content="{{ seo_og_image }}">
        <meta name="twitter:site" content="@_nicolaslps">
        <meta name="twitter:creator" content="@_nicolaslps">

        <script>
            (() => {
                try {
                    const ls = localStorage;

                    if (ls.getItem('theme') === 'dark') {
                        document.documentElement.classList.add('dark');
                    }

                    const css = ls.getItem('theme_css');
                    if (css) {
                        const style = document.createElement('style');
                        style.textContent = css;
                        document.head.append(style);
                    }
                } catch {}
            })();
        </script>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% if app.environment == 'prod' and not app.debug %}
            <script defer src="https://assets.onedollarstats.com/stonks.js"></script>
            {% if ga4_measurement_id %}
                <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_measurement_id|e('url') }}"></script>
                <script>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', '{{ ga4_measurement_id|e('js') }}');
                </script>
            {% endif %}
        {% endif %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-neutral-white text-black dark:bg-neutral-900 dark:text-neutral-50">
        <div class="relative z-10 flex min-h-svh flex-col shadow-page bg-neutral-50 dark:bg-neutral-950">
            {{ include('_navbar.html.twig') }}
            {% block body %}{% endblock %}
        </div>
        {{ include('_footer.html.twig') }}
    </body>
</html>
