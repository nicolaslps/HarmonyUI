<div class="not-prose my-6 overflow-hidden rounded-lg border border-border" data-code-source="{{ source }}">
    <div class="demo-preview flex items-center justify-center gap-4 bg-background p-8">
        {{ rendered|raw }}
    </div>
    {% set lines = source|trim("\n")|split("\n")|length %}
    {% if lines > 4 %}
        <div class="relative border-t border-border" data-controller="code-demo">
            <pre class="max-h-28 select-none overflow-x-auto overflow-y-hidden bg-background p-4 text-sm leading-relaxed text-foreground" data-code-demo-target="code"><code>{{ source|highlight('twig') }}</code></pre>
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-background via-background/70 to-transparent" data-code-demo-target="fade"></div>
            <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
                <twig:ui:Button type="button" variant="outline" class="pointer-events-auto shadow-sm" data-action="code-demo#show" data-code-demo-target="button">
                    View code
                </twig:ui:Button>
            </div>
        </div>
    {% else %}
        <pre class="overflow-x-auto border-t border-border bg-background p-4 text-sm leading-relaxed text-foreground"><code>{{ source|highlight('twig') }}</code></pre>
    {% endif %}
</div>
