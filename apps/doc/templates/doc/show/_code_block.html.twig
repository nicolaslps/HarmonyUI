<div class="not-prose relative my-6 overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800" data-controller="clipboard" data-clipboard-content-value="{{ source }}">
    {% if language %}
        <div class="flex items-center border-b border-neutral-200 bg-neutral-100/40 px-4 py-1.5 dark:border-neutral-800 dark:bg-neutral-800/40">
            <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">{{ language }}</span>
        </div>
    {% endif %}
    <div class="relative">
        <pre class="overflow-x-auto bg-white p-4 text-sm leading-relaxed text-neutral-950 dark:bg-neutral-900 dark:text-neutral-50"><code>{{ highlighted|raw }}</code></pre>
        <div class="absolute top-2 right-2">
            <twig:ui:Button type="button" variant="outline" size="icon-xs" class="shadow-sm" data-action="clipboard#copy">
                <twig:ux:icon name="lucide:copy" data-clipboard-target="icon" />
                <twig:ux:icon name="lucide:check" class="hidden" data-clipboard-target="check" />
            </twig:ui:Button>
        </div>
    </div>
</div>
