<div class="not-prose relative my-6 overflow-hidden rounded-lg border border-border" data-controller="clipboard" data-clipboard-content-value="{{ source }}">
    {% if language %}
        <div class="flex items-center border-b border-border bg-muted/40 px-4 py-1.5">
            <span class="text-xs font-medium text-muted-foreground">{{ language }}</span>
        </div>
    {% endif %}
    <div class="relative">
        <pre class="overflow-x-auto bg-background p-4 text-sm leading-relaxed text-foreground"><code>{{ highlighted|raw }}</code></pre>
        <div class="absolute top-2 right-2">
            <twig:ui:Button type="button" variant="outline" size="icon-xs" class="shadow-sm" data-action="clipboard#copy">
                <twig:ux:icon name="lucide:copy" data-clipboard-target="icon" />
                <twig:ux:icon name="lucide:check" class="hidden" data-clipboard-target="check" />
            </twig:ui:Button>
        </div>
    </div>
</div>
