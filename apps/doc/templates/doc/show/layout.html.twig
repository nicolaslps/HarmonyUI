{% extends 'base.html.twig' %}

{% block seo_title %}{{ page.meta.title }} - HarmonyUI for Symfony{% endblock %}

{% block seo_description -%}
    {{ page.meta.description ?: 'HarmonyUI documentation: accessible, extensible Twig components for Symfony, styled with Tailwind CSS.' }}
{%- endblock %}

{% block og_title %}{{ page.meta.title }}{% endblock %}

{% block body %}
    <div class="mx-auto flex w-full max-w-352 gap-12 px-6 py-8">
        <aside class="hidden w-56 shrink-0 lg:block">
            <nav class="sticky top-22 space-y-6">
                {% for category, pages in navigation %}
                    <div>
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{{ category }}</p>
                        <ul class="space-y-1 text-sm">
                            {% for item in pages %}
                                <li>
                                    <a href="{{ path('app_docs_show', {slug: item.slug}) }}"
                                       class="{{ item.slug == page.meta.slug ? 'font-semibold text-slate-900' : 'text-slate-600 hover:text-slate-900' }}">
                                        {{ item.title }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </nav>
        </aside>

        <article class="prose min-w-0 max-w-3xl flex-1">
            {% block content %}{% endblock %}
        </article>

        <aside class="hidden w-56 shrink-0 xl:block">
            {% if page.headings|length > 1 %}
                <nav class="sticky top-22" data-controller="toc" data-toc-offset-value="88">
                    <p class="mb-2 text-xs font-bold uppercase tracking-wide text-primary">On this page</p>
                    <ul class="text-sm">
                        {% for heading in page.headings %}
                            <li>
                                <twig:ui:Button
                                    as="a"
                                    variant="link"
                                    href="#{{ heading.id }}"
                                    data-toc-target="link"
                                    class="text-muted-foreground font-normal whitespace-normal hover:text-foreground data-active:text-foreground data-active:font-bold {{ heading.level == 3 ? 'pl-7' : heading.level == 2 ? 'pl-5' : 'pl-3' }}"
                                >
                                    {{ heading.text }}
                                </twig:ui:Button>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </aside>
    </div>
{% endblock %}
