{% extends 'doc/show/layout.html.twig' %}

{% block content %}
    <header>
        <h1>{{ page.meta.title }}</h1>
        {% if page.meta.description %}
            <p class="-mt-4 text-base text-slate-600">{{ page.meta.description }}</p>
        {% endif %}
    </header>

    {{ page.html|raw }}

    <nav class="not-prose mt-12 flex justify-between pt-6">
        {% if previous %}
            <twig:ui:Button as="a" variant="secondary" href="{{ path('app_docs_show', {slug: previous.slug}) }}">
                <twig:ux:icon name="lucide:arrow-left" data-icon="inline-start" />
                {{ previous.title }}
            </twig:ui:Button>
        {% else %}
            <span></span>
        {% endif %}
        {% if next %}
            <twig:ui:Button as="a" variant="secondary" href="{{ path('app_docs_show', {slug: next.slug}) }}">
                {{ next.title }}
                <twig:ux:icon name="lucide:arrow-right" data-icon="inline-end" />
            </twig:ui:Button>
        {% endif %}
    </nav>
{% endblock %}
