# Copy to .env.kamal (NOT committed) and fill in the values.
# Load it before running Kamal:
#   set -a && source .env.kamal && set +a && kamal deploy            # production
#   set -a && source .env.kamal && set +a && kamal deploy -d staging # staging

# --- Container registry (ghcr.io) ---
KAMAL_REGISTRY_USERNAME=
# GitHub Personal Access Token with the write:packages scope
KAMAL_REGISTRY_PASSWORD=

# --- Deploy targets (server IP / hostname) ---
KAMAL_PROD_HOST=
KAMAL_STAGING_HOST=

# --- SSH access to the servers ---
KAMAL_SSH_DEPLOY_USER=
# Private key on a single line, with real newlines escaped as \n
KAMAL_SSH_DEPLOY_KEY=

# --- Symfony ---
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
