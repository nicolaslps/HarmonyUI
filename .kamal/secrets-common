# Kamal secrets — values read from the shell environment.
# Loaded from the non-versioned .env.kamal before deploying:
#   set -a && source .env.kamal && set +a && kamal deploy

APP_SECRET=$APP_SECRET
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# SSH deploy key: expand the escaped single-line value from .env.kamal into real newlines.
KAMAL_SSH_DEPLOY_KEY=$(printf '%b' "$KAMAL_SSH_DEPLOY_KEY")
