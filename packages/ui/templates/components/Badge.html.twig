{%- props variant = 'soft', size = 'md', color = null, as = 'span' -%}
{%- set style = hui('badge') -%}
<{{ as }}
    class="{{ style.apply({variant: variant, size: size, color: color}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'badge',
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
