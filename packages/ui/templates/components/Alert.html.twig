{%- props variant = null, color = null, as = 'div' -%}
{%- set variantColors = {
    'danger': 'red',
    'info': 'blue',
    'success': 'green',
    'warning': 'yellow',
} -%}
{%- set color = variantColors[variant] ?? color ?? 'neutral' -%}
{%- set style = hui('alert') -%}
<{{ as }}
    class="{{ style.apply({color: color}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'alert',
        role: 'alert',
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
