{%- props as = 'div' -%}
{%- set _hui_dialog_id = inject('dialog_id') -%}
<div
    class="{{ hui('dialog-backdrop').apply({}) }}"
    data-scope="dialog"
    data-part="backdrop"
    data-owner="{{ _hui_dialog_id }}"
    hidden
></div>
<div
    class="{{ hui('dialog-positioner').apply({}) }}"
    data-scope="dialog"
    data-part="positioner"
    data-owner="{{ _hui_dialog_id }}"
    hidden
>
    <{{ as }}
        class="{{ hui('dialog-content').apply({}, attributes.render('class'))|tailwind_merge }}"
        {{ attributes.defaults({
            'data-slot': 'dialog-content',
            'data-scope': 'dialog',
            'data-part': 'content',
            'data-owner': _hui_dialog_id,
            hidden: true,
        }) }}
    >
        {%- block content %}{% endblock -%}
    </{{ as }}>
</div>
