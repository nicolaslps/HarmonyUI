{%- props as = 'div' -%}
{%- set _hui_dialog_id = inject('dialog_id') -%}
<{{ as }}
    class="{{ hui('dialog-description').apply({}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'dialog-description',
        'data-scope': 'dialog',
        'data-part': 'description',
        'data-owner': _hui_dialog_id,
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
