{%- props as = 'div' -%}
{%- set _hui_popover_id = inject('popover_id') -%}
<div
    class="{{ hui('popover-positioner').apply({}) }}"
    data-scope="popover"
    data-part="positioner"
    data-owner="{{ _hui_popover_id }}"
    hidden
>
    <{{ as }}
        class="{{ hui('popover-content').apply({}, attributes.render('class'))|tailwind_merge }}"
        {{ attributes.defaults({
            'data-slot': 'popover-content',
            'data-scope': 'popover',
            'data-part': 'content',
            'data-owner': _hui_popover_id,
            hidden: true,
        }) }}
    >
        {%- block content %}{% endblock -%}
    </{{ as }}>
</div>
