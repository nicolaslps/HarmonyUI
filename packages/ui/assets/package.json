{
    "name": "@harmonyui/ui",
    "version": "0.1.0",
    "license": "MIT",
    "peerDependencies": {
        "@hotwired/stimulus": ">=3.0.0"
    },
    "dependencies": {
        "@zag-js/dialog": "^1.43.0",
        "@zag-js/popover": "^1.43.0",
        "@zag-js/vanilla": "^1.43.0"
    },
    "symfony": {
        "controllers": {
            "accordion": {
                "main": "controllers/accordion_controller.js",
                "name": "hui-accordion",
                "fetch": "eager",
                "enabled": true
            },
            "avatar": {
                "main": "controllers/avatar_controller.js",
                "name": "hui-avatar",
                "fetch": "eager",
                "enabled": true
            },
            "dialog": {
                "main": "controllers/dialog_controller.js",
                "name": "hui-dialog",
                "fetch": "eager",
                "enabled": true
            },
            "popover": {
                "main": "controllers/popover_controller.js",
                "name": "hui-popover",
                "fetch": "eager",
                "enabled": true
            }
        }
    }
}
