{%- props multiple = false, collapsible = true, disabled = false, value = [], dir = 'ltr', as = 'div' -%}
{%- set _hui_accordion_open_values = value -%}
<{{ as }}
    data-slot="accordion"
    data-part="root"
    dir="{{ dir }}"
    data-controller="hui-accordion"
    data-hui-accordion-multiple-value="{{ multiple ? 'true' : 'false' }}"
    data-hui-accordion-collapsible-value="{{ collapsible ? 'true' : 'false' }}"
    data-hui-accordion-disabled-value="{{ disabled ? 'true' : 'false' }}"
    data-hui-accordion-value-value="{{ value|json_encode }}"
    data-hui-accordion-dir-value="{{ dir }}"
    class="{{ hui('accordion').apply({}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
