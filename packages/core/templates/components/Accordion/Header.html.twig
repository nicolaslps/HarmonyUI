{%- props as = 'h3' -%}
<{{ as }} data-slot="accordion-header" class="{{ hui('accordion-header').apply({}) }}">
    <button
        type="button"
        data-part="item-trigger"
        data-state="{{ _hui_accordion_item_open|default(false) ? 'open' : 'closed' }}"
        aria-expanded="{{ _hui_accordion_item_open|default(false) ? 'true' : 'false' }}"
        class="{{ hui('accordion-trigger').apply({}, attributes.render('class'))|tailwind_merge }}"
        {{ attributes }}
    >
        {%- block content %}{% endblock -%}
        <span data-part="item-indicator" data-state="{{ _hui_accordion_item_open|default(false) ? 'open' : 'closed' }}" class="{{ hui('accordion-indicator').apply({}) }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </span>
    </button>
</{{ as }}>
