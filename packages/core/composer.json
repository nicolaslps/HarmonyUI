{
    "name": "harmonyui/core",
    "description": "HarmonyUI Symfony Package",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "HarmonyUI\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HarmonyUI\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    }
}
